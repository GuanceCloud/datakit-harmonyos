export { Status } from '../bean/Status';
export { TraceType } from '../trace/TraceType';

export enum EnvType {
  PROD = "prod",
  GRAY = "gray",
  PRE = "pre",
  COMMON = "common",
  LOCAL = "local"
}

/**
 * SDK internal log threshold.
 *
 * This follows Android SDKLogLevel semantics: setting a level outputs that
 * level and all more severe levels when FTSDKConfig.setDebug(true) is enabled.
 */
export enum SDKLogLevel {
  V = "V",
  D = "D",
  I = "I",
  W = "W",
  E = "E"
}

export enum SyncPageSize {
  MINI = 5,
  MEDIUM = 10,
  LARGE = 50,
}

export enum DetectFrequency {
  /**
   * Default sampling frequency: once every 500 ms
   */
  DEFAULT = 500,

  /**
   * High-frequency collection, once every 100 ms
   */
  FREQUENT = 100,

  /**
   * Low-frequency collection, once every 1000 ms
   */
  RARE = 1000,
}

export enum DataType {
  /**
   * Native app RUM data
   */
  RUM_APP = "rum_app",
  /**
   * RUM data generated by JavaScript in a WebView requires additional configuration using the <a href="https://github.com/GuanceCloud/datakit-js">JS SDK</a>
   */
  RUM_WEBVIEW = "rum_webview",
  /**
   * SDK log data
   */
  LOG = "log",
  // /**
  //  * SDK trace data, currently unused
  //  */
  // TRACE = "trace"
}

export enum DBCacheDiscard {
  DISCARD = "discard",
  DISCARD_OLDEST = "discard_oldest"
}

export enum RUMCacheDiscard {
  DISCARD = "discard",
  DISCARD_OLDEST = "discard_oldest"
}

export enum LogCacheDiscard {
  /**
   * Drop appended log entries.
   */
  DISCARD = "discard",

  /**
   * Delete the oldest log entries before appending.
   */
  DISCARD_OLDEST = "discard_oldest"
}
