export enum EnvType {
  PROD = "prod",
  GRAY = "gray",
  PRE = "pre",
  COMMON = "common",
  LOCAL = "local"
}

export enum SyncPageSize {
  MINI = 5,
  MEDIUM = 10,
  LARGE = 50,
}

export enum LogCacheDiscard {
  /**
   * Drop the oldest entries, default behavior
   */
  DISCARD,

  /**
   * Drop the newest entries
   */
  DISCARD_OLDEST
}

export enum Status {
  /**
   * Info
   */
  INFO = "info",

  /**
   * Debug
   */
  DEBUG = "debug",

  /**
   * Warning
   */
  WARNING = "warning",

  /**
   * Error
   */
  ERROR = "error",

  /**
   * Critical
   */
  CRITICAL = "critical",

  /**
   * Recovery
   */
  OK = "ok"
}

export enum TraceType {
  /**
   * Datadog trace, default value, {@link FTTraceConfig#traceType}
   * <p>
   * x-datadog-trace-id
   * x-datadog-parent-id
   * x-datadog-sampling-priority
   * x-datadog-origin
   *
   * <a href="https://docs.datadoghq.com/synthetics/apm/">Learn more</a>
   *
   */
  DDTRACE,

  /**
   * zipkin multi header
   * <p>
   * X-B3-TraceId
   * X-B3-SpanId
   * X-B3-Sampled
   *
   * <a href="https://github.com/openzipkin/b3-propagation">Learn more</a>
   *
   */
  ZIPKIN_MULTI_HEADER,

  /**
   * zipkin single header,b3
   *
   * <a href="https://github.com/openzipkin/b3-propagation">Learn more</a>
   */
  ZIPKIN_SINGLE_HEADER,

  /**
   * w3c, traceparent
   *
   * <a href="https://www.w3.org/TR/trace-context/#traceparent-header-field-values">Learn more</a>
   */
  TRACEPARENT,

  /**
   * skywalking 8.0+, sw-8
   *
   * <a href="https://skywalking.apache.org/docs/main/next/en/api/x-process-propagation-headers-v3/#skywalking-cross-process-propagation-headers-protocol">Learn more</a>
   */
  SKYWALKING,

  /**
   * jaeger, header uber-trace-id
   */
  JAEGER
}

export enum DetectFrequency {
  /**
   * Default sampling frequency: once every 500 ms
   */
  DEFAULT = 500,

  /**
   * High-frequency collection, once every 100 ms
   */
  FREQUENT = 100,

  /**
   * Low-frequency collection, once every 1000 ms
   */
  RARE = 1000,
}

export enum DataType {
  /**
   * Native app RUM data
   */
  RUM_APP = "rum_app",
  /**
   * RUM data generated by JavaScript in a WebView requires additional configuration using the <a href="https://github.com/GuanceCloud/datakit-js">JS SDK</a>
   */
  RUM_WEBVIEW = "rum_webview",
  /**
   * SDK log data
   */
  LOG = "log",
  // /**
  //  * SDK trace data, currently unused
  //  */
  // TRACE = "trace"
}

export enum DBCacheDiscard {
  DISCARD = "discard",
  DISCARD_OLDEST = "discard_oldest"
}

export enum RUMCacheDiscard {
  DISCARD = "discard",
  DISCARD_OLDEST = "discard_oldest"
}





