{
  "apiType": "stageMode",
  "buildOption": {
    "sourceOption": {
      "workers": [
        "./src/main/ets/components/thread/workers/EventConsumerWorker.ets",
        "./src/main/ets/components/thread/workers/LogConsumerWorker.ets",
        "./src/main/ets/components/thread/workers/DataProcessWorker.ets",
        "./src/main/ets/components/thread/workers/CrashFileWorker.ets",
        "./src/main/ets/components/thread/workers/ANRWorker.ets",
        "./src/main/ets/components/thread/workers/BackgroundWorker.ets",
        "./src/main/ets/components/thread/workers/DataUploadWorker.ets"
      ]
    }
  },
  "buildOptionSet": [
    {
      "name": "release",
      "arkOptions": {
        "obfuscation": {
          "ruleOptions": {
            "enable": false,
            "files": [
              "./obfuscation-rules.txt"
            ]
          },
          "consumerFiles": [
            "./consumer-rules.txt"
          ]
        }
      },
    },
  ],
  "targets": [
    {
      "name": "default"
    },
    {
      "name": "ohosTest"
    }
  ]
}
