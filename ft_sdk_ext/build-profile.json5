{
  "apiType": "stageMode",
  "buildOption": {
    "arkOptions": {
      "byteCodeHar": true
    }
  },
  "buildOptionSet": [
    {
      "name": "release",
      "arkOptions": {
        "obfuscation": {
          "ruleOptions": {
            "enable": true,
            "files": [
              "./obfuscation-rules.txt"
            ]
          },
          "consumerFiles": [
            "./consumer-rules.txt"
          ]
        }
      },
    },
  ],
  "targets": [
    {
      "name": "default"
    },
    {
      "name": "ohosTest",
      "config": {
        "buildOption": {
          "sourceOption": {
            // The standalone test HAP must include ft_sdk's Worker entry points.
            "workers": [
              "../ft_sdk/src/main/ets/components/thread/workers/EventConsumerWorker.ets",
              "../ft_sdk/src/main/ets/components/thread/workers/LogConsumerWorker.ets",
              "../ft_sdk/src/main/ets/components/thread/workers/DataProcessWorker.ets",
              "../ft_sdk/src/main/ets/components/thread/workers/CrashWorker.ets",
              "../ft_sdk/src/main/ets/components/thread/workers/ANRWorker.ets",
              "../ft_sdk/src/main/ets/components/thread/workers/DataUploadWorker.ets"
            ]
          }
        }
      }
    }
  ]
}
