{
  "name": "ft_sdk_ext",
  "version": "0.1.14-alpha03",
  "description": "Guance HarmonyOS SDK extensions for newer compiler and platform capabilities.",
  "main": "Index.ets",
  "author": "Guance",
  "license": "Apache-2.0",
  "dependencies": {
    // Build-time local HAR reference for ft_sdk_ext itself.
