{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      }
    ],
    "srcEntry": "./ets/abilitystage/EntryAbilityStage.ets",
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          }
        ]
      },
      {
        "name": "SecondaryLaunchAbility",
        "srcEntry": "./ets/secondaryability/SecondaryLaunchAbility.ets",
        "description": "Multi-UIAbility cold-launch verification target",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true
      },
      {
        "name": "LaunchSuspendTestAbility",
        "srcEntry": "./ets/launchsuspendability/LaunchSuspendTestAbility.ets",
        "description": "Offline launch-source and suspension clock verification",
        "launchType": "singleton",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true
      },
      {
        "name": "HeapPressureTestAbility",
        "srcEntry": "./ets/heappressureability/HeapPressureTestAbility.ets",
        "description": "Application-owned heap pressure verification",
        "launchType": "singleton",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true
      }
    ],

    "extensionAbilities": [
      {
        "name": "BackgroundLaunchWorkSchedulerAbility",
        "srcEntry": "./ets/workscheduler/BackgroundLaunchWorkSchedulerAbility.ets",
        "type": "workScheduler",
        "exported": false,
        "description": "No-UI WorkScheduler cold-launch verification"
      },
      {
        "name": "StressServiceAbility",
        "srcEntry": "./ets/serviceability/StressServiceAbility.ets",
        "type": "appService",
        "exported": true,
        "visible": true,
        "description": "Stress test service"
      },
      {
        "name": "EntryBackupAbility",
        "srcEntry": "./ets/entrybackupability/EntryBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ]
      },
    ]
  }
}
