{
  "modelVersion": "5.0.0",
  "description": "FT SDK HarmonyOS - Monitoring, Analytics, and Performance Management SDK",
  "dependencies": {
    "@abner/dialog": "^1.2.6"
  },
  "devDependencies": {
    "@ohos/hypium": "1.0.19"
  },
  "overrides": {
    // Consumer-side compatibility override for local HAR integration.
    // This entry takes precedence over ft_sdk_ext/oh-package.json5 so the app
    // resolves @guancecloud/ft_sdk from the consumer workspace instead of the
    // module's
    // internal build-time relative reference.
    "@guancecloud/ft_sdk": "file:./ft_sdk" //
  },
  "dynamicDependencies": {}
}
